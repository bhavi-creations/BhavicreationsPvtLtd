DirectoryIndex index.php index.html

Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect direct .php requests to extensionless URLs.
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,NE]

    # Serve matching PHP files when the URL has no extension.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # If blog/newsletter slugs are needed, use prefixed URLs to avoid conflicts:
    # RewriteRule ^newsletter/([a-zA-Z0-9_-]+)/?$ newsletter.php?slug=$1 [L,QSA]
    # RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ fullblog.php?id=$1 [L,QSA]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
